# ==============================================================================
# µLearn Concierge — Environment Configuration
# ==============================================================================

# LLM Providers to try in order of priority (comma-separated): gemini, openai_compat
LLM_PROVIDERS=gemini,openai_compat

# --- 1. Google Gemini Provider ---
# Get a key at https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# --- 2. OpenAI-Compatible Provider (e.g. OpenRouter, Ollama, vLLM) ---
OPENAI_COMPAT_BASE_URL=https://openrouter.ai/api/v1
OPENAI_COMPAT_API_KEY=your_openrouter_or_openai_api_key_here
# One or more candidate model slugs, comma-separated, tried in order
OPENAI_COMPAT_MODEL=meta-llama/llama-3.3-70b-instruct,deepseek/deepseek-chat

# Optional: HTTP-Referer header for OpenRouter analytics
SITE_URL=https://mulearn.org

# --- Discord Announcements Sync Script ---
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_CHANNEL_IDS=channel_id_1,channel_id_2

# --- Server & Rate Limiting Configuration ---
PORT=5000
RATE_LIMIT=20
RATE_WINDOW=600
