# ==============================================================================
# µLearn Concierge — environment configuration
# Copy this file to .env and fill in your own values. NEVER commit .env.
# Every variable is optional: with no keys at all the app still runs in
# offline mode (rule-based FAQ + small talk).
# ==============================================================================

# AI providers, tried in this order. Use the names: openai_compat, gemini
LLM_PROVIDERS=openai_compat,gemini

# --- OpenAI-compatible provider (OpenRouter shown; Groq, Cerebras etc. also work) ---
# Free OpenRouter models end in ":free". Slugs are comma-separated and tried in order.
OPENAI_COMPAT_BASE_URL=https://openrouter.ai/api/v1
OPENAI_COMPAT_API_KEY=your_openrouter_api_key_here
OPENAI_COMPAT_MODEL=nvidia/nemotron-3.5-lightning:free,nvidia/nemotron-3-ultra-550b-a55b:free

# --- Google Gemini provider (backup) ---
# Get a key at https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Optional: your site URL, sent to OpenRouter as the HTTP-Referer header
SITE_URL=http://localhost:5000

# --- Discord announcements (optional) ---
# A bot token and the IDs of the channel(s) the bot may read (comma-separated).
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_CHANNEL_IDS=channel_id_1,channel_id_2
# Set to false to turn off the hourly background sync inside the web app
DISCORD_AUTO_SYNC=true
DISCORD_SYNC_INTERVAL=3600

# --- Server and rate limiting ---
PORT=5000
RATE_LIMIT=20
RATE_WINDOW=600
